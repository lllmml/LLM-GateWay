# Local development only. Do not commit a populated .env file.
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable

# Generate a development value with: openssl rand -base64 32
# Must decode to exactly 32 bytes for AES-256-GCM credential encryption.
CREDENTIAL_MASTER_KEY=

# GitHub OAuth Web application credentials. Keep the callback URL exact:
# ${PUBLIC_CONSOLE_URL}/auth/github/callback
# Vite serves the Web console in development; /api and /auth proxy to :8081.
PUBLIC_CONSOLE_URL=http://127.0.0.1:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
SESSION_TOKEN_PEPPER=

# Generate a separate value with: openssl rand -base64 32
VIRTUAL_KEY_PEPPER=

DATA_PLANE_ADDR=:8080
CONTROL_PLANE_ADDR=:8081
OPS_ADDR=:9090
LOG_LEVEL=info
DATABASE_CONNECT_TIMEOUT=5s
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
UPSTREAM_REQUEST_TIMEOUT=1m
UPSTREAM_STREAM_MAX_DURATION=10m
# Week 8 Reliability Baseline. Rate limits and concurrency caps default to 0
# (disabled); set them to enable. RETRY_MAX_RETRIES is the number of retries
# after the initial attempt (0 disables retries; bound 0-5).
RATE_LIMIT_KEY_REQUESTS_PER_MINUTE=0
RATE_LIMIT_PROJECT_REQUESTS_PER_MINUTE=0
# RATE_LIMIT_KEY_REQUESTS_PER_MINUTE=120
# RATE_LIMIT_PROJECT_REQUESTS_PER_MINUTE=1200
RATE_LIMITER_ENTRY_CAP=10000
RATE_LIMITER_IDLE_TTL=10m
RATE_LIMITER_SWEEP_INTERVAL=1m
DATA_PLANE_MAX_CONCURRENT_REQUESTS=0
DATA_PLANE_MAX_CONCURRENT_STREAMS=0
RETRY_MAX_RETRIES=1
RETRY_BACKOFF_MAX=2s
# Week 9 distributed rate limiter (ADR-018). The default local in-memory mode
# never requires Redis. Opt in for a multi-replica deployment:
#   RATE_LIMITER_MODE=distributed
#   REDIS_URL=redis://127.0.0.1:6379/0
# The Redis client uses go-redis with MaxRetries disabled (-1; note that 0
# would silently mean the default 3 retries) and ContextTimeoutEnabled, so an
# ambiguous mutating admission is never automatically retransmitted.
# REDIS_COMMAND_TIMEOUT bounds one admission command; REDIS_PROBE_INTERVAL and
# REDIS_PROBE_THRESHOLD drive the degraded-mode recovery probes;
# RATE_LIMITER_REPLICA_FACTOR derives the bounded local emergency quota
# (emergency = max(1, floor(normal / factor)) per enabled scope).
RATE_LIMITER_MODE=local
# REDIS_URL=
REDIS_COMMAND_TIMEOUT=500ms
REDIS_PROBE_INTERVAL=1s
REDIS_PROBE_THRESHOLD=3
RATE_LIMITER_REPLICA_FACTOR=2
