{
  "title": "Gateway Overview (minimal)",
  "uid": "gateway-overview",
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "schemaVersion": 41,
  "tags": ["gateway"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "title": "Gateway requests (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total[1m])) by (provider, status)",
          "legendFormat": "{{provider}} {{status}}"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Active gateway requests",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "gateway_active_requests",
          "legendFormat": "active requests"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "title": "Failed gateway requests (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total{status=\"failed\"}[1m])) by (provider)",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi" }
      }
    }
  ]
}
